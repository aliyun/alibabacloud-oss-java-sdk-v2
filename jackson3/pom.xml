<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Jackson 3 flavor of alibabacloud-oss-v2.
        Sources are taken from ../src/main/java at build time, Jackson 2 packages are rewritten to
        Jackson 3 packages (com.fasterxml.jackson.annotation is shared by both and kept as is),
        and internal/serde/JacksonMappers.java is replaced by the one under ./src/main/java.
        Keep the version in sync with ../pom.xml.
    -->
    <groupId>com.aliyun</groupId>
    <artifactId>alibabacloud-oss-v2-jackson3</artifactId>
    <version>0.6.1</version>
    <name>Alibaba Cloud OSS SDK For Java V2 (Jackson 3)</name>
    <description>The Alibaba Cloud OSS SDK for Java (Jackson 3 based) is used to access the Alibaba Cloud Object Storage Service</description>
    <url>https://github.com/aliyun/alibabacloud-oss-java-sdk-v2</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>

        <main.basedir>${project.basedir}/..</main.basedir>
        <gen.src.dir>${project.build.directory}/generated-sources/jackson3</gen.src.dir>
        <gen.test.dir>${project.build.directory}/generated-test-sources/jackson3</gen.test.dir>

        <!-- test dependencies -->
        <junit5.version>5.13.0</junit5.version>
        <assertj.version>3.27.7</assertj.version>
        <slf4j.version>2.0.17</slf4j.version>
        <bcprov-jdk18on.version>1.86</bcprov-jdk18on.version>

        <!-- build plugin dependencies-->
        <maven.surefire.version>3.1.2</maven.surefire.version>
        <maven-compiler-plugin.version>3.8.1</maven-compiler-plugin.version>
        <maven-antrun-plugin.version>3.1.0</maven-antrun-plugin.version>
        <maven-javadoc-plugin.version>3.4.1</maven-javadoc-plugin.version>
        <build-helper-maven-plugin.version>3.3.0</build-helper-maven-plugin.version>
        <maven-source-plugin.version>3.2.1</maven-source-plugin.version>
        <maven-gpg-plugin.version>3.1.0</maven-gpg-plugin.version>
        <maven-publishing-plugin.version>0.8.0</maven-publishing-plugin.version>

        <httpcomponents.httpclient.version>4.5.14</httpcomponents.httpclient.version>
        <httpcomponents.client5.version>5.5</httpcomponents.client5.version>

        <!-- serialize and deserialize xml and json, java.time support is built in since Jackson 3 -->
        <jackson3.version>3.0.4</jackson3.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>tools.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-xml</artifactId>
            <version>${jackson3.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
            <version>${httpcomponents.client5.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.httpcomponents</groupId>
            <artifactId>httpclient</artifactId>
            <version>${httpcomponents.httpclient.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit5.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <version>${junit5.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>${bcprov-jdk18on.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>jcl-over-slf4j</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>${main.basedir}/src/main/resources</directory>
                <includes>
                    <include>versioninfo.properties</include>
                </includes>
            </resource>
        </resources>
        <testResources>
            <testResource>
                <directory>${main.basedir}/src/test/resources</directory>
            </testResource>
        </testResources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>${maven-antrun-plugin.version}</version>
                <executions>
                    <execution>
                        <id>generate-jackson3-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <delete dir="${gen.src.dir}" quiet="true"/>
                                <copy todir="${gen.src.dir}" encoding="UTF-8" outputencoding="UTF-8">
                                    <fileset dir="${main.basedir}/src/main/java">
                                        <include name="**/*.java"/>
                                        <!-- replaced by ./src/main/java -->
                                        <exclude name="**/internal/serde/JacksonMappers.java"/>
                                        <!-- same as the main build -->
                                        <exclude name="**/transport/jdkclient/**"/>
                                        <exclude name="**/paginator/flow/**"/>
                                    </fileset>
                                    <filterchain>
                                        <tokenfilter>
                                            <replacestring from="com.fasterxml.jackson.databind." to="tools.jackson.databind."/>
                                            <replacestring from="com.fasterxml.jackson.dataformat.xml." to="tools.jackson.dataformat.xml."/>
                                            <replacestring from="com.fasterxml.jackson.core." to="tools.jackson.core."/>
                                        </tokenfilter>
                                    </filterchain>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-jackson3-test-sources</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <delete dir="${gen.test.dir}" quiet="true"/>
                                <copy todir="${gen.test.dir}" encoding="UTF-8" outputencoding="UTF-8">
                                    <fileset dir="${main.basedir}/src/test/java">
                                        <include name="**/*.java"/>
                                        <!-- tests that drive Jackson 2 mappers directly are skipped for now -->
                                        <not><contains text="com.fasterxml.jackson.databind"/></not>
                                        <not><contains text="com.fasterxml.jackson.core"/></not>
                                        <not><contains text="com.fasterxml.jackson.datatype"/></not>
                                        <not><contains text="com.fasterxml.jackson.dataformat.xml.XmlMapper;"/></not>
                                        <not><contains text="com.fasterxml.jackson.dataformat.xml.ser"/></not>
                                        <not><contains text="com.fasterxml.jackson.dataformat.xml.deser"/></not>
                                    </fileset>
                                    <filterchain>
                                        <tokenfilter>
                                            <replacestring from="com.fasterxml.jackson.databind." to="tools.jackson.databind."/>
                                            <replacestring from="com.fasterxml.jackson.dataformat.xml." to="tools.jackson.dataformat.xml."/>
                                            <replacestring from="com.fasterxml.jackson.core." to="tools.jackson.core."/>
                                        </tokenfilter>
                                    </filterchain>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>${build-helper-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>add-jackson3-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${gen.src.dir}</source>
                            </sources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>add-jackson3-test-source</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${gen.test.dir}</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <encoding>UTF-8</encoding>
                    <forceJavacCompilerUse>true</forceJavacCompilerUse>
                    <compilerArgument>-proc:none</compilerArgument>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.version}</version>
                <configuration>
                    <includes>
                        <include>**/Test*.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*Test.java</include>
                        <include>**/*TestCase.java</include>
                    </includes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>${maven-source-plugin.version}</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven-javadoc-plugin.version}</version>
                <configuration>
                    <detectJavaApiLink>false</detectJavaApiLink>
                    <notree>true</notree>
                    <includeDependencySources>false</includeDependencySources>
                    <doclint>all,-missing</doclint>
                    <excludePackageNames>*.internal;*.internal.*;*.impl;*.transport.jdkclient;*.paginator.flow</excludePackageNames>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>${maven-gpg-plugin.version}</version>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>${maven-publishing-plugin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <autoPublish>true</autoPublish>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <scm>
        <connection>scm:git:git://github.com/aliyun/alibabacloud-oss-java-sdk-v2.git</connection>
        <developerConnection>scm:git:git://github.com/aliyun/alibabacloud-oss-java-sdk-v2.git</developerConnection>
        <url>https://github.com/aliyun/alibabacloud-oss-java-sdk-v2</url>
    </scm>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution/>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>aliyunproducts</id>
            <name>Aliyun SDK</name>
            <email>aliyunsdk@aliyun.com</email>
        </developer>
    </developers>

    <distributionManagement>
        <snapshotRepository>
            <id>sonatype-nexus-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
        </snapshotRepository>
        <repository>
            <id>sonatype-nexus-staging</id>
            <url>https://central.sonatype.com</url>
        </repository>
    </distributionManagement>

</project>
